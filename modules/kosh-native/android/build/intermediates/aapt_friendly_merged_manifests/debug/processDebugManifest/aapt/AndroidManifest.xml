<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.koshnative" >

    <uses-sdk android:minSdkVersion="24" />

    <!-- Bank / card SMS are read on-device to capture expenses. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Granted by the user in system settings; used for subscription usage tracking. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: list launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>